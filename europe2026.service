# /etc/systemd/system/europe2026.service
# Keeps the site running on 0.0.0.0:2026 across reboots/crashes.
#   sudo cp europe2026.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now europe2026
#   sudo systemctl status europe2026
# Adjust WorkingDirectory to wherever you cloned the repo.

[Unit]
Description=Europe2026 Lucerne hotel site (static, 0.0.0.0:2026)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/var/www/Europe2026
ExecStart=/usr/bin/python3 -m http.server 2026 --bind 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
